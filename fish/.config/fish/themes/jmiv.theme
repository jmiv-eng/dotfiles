# name: jmiv
# preferred_background: 242424
#
# Fixed hex colours, so fish looks the same in any terminal. Loaded by
# config.fish; fish_color_prompt_* is the palette for functions/fish_prompt.fish.

# Command line
fish_color_normal ffffff
fish_color_command ffffff
fish_color_param 13c299
fish_color_quote e3c401
fish_color_redirection 13c299 --bold
fish_color_end 47b413
fish_color_error ff4d51
fish_color_comment f62b5a
fish_color_operator 24dfc4
fish_color_escape 24dfc4
fish_color_autosuggestion 616161
fish_color_valid_path --underline
fish_color_cancel -r
fish_color_history_current --bold
fish_color_search_match e6e6e6 --background=616161 --bold
fish_color_selection e6e6e6 --background=616161 --bold

# Completion pager
fish_pager_color_prefix --bold --underline
fish_pager_color_description e3c401 --italics
fish_pager_color_progress ffffff --background=13c299 --bold
fish_pager_color_selected_background -r

# Standard prompt colours (also used by fish's sample prompts)
fish_color_cwd 24acd4
fish_color_cwd_root f62b5a
fish_color_user 616161
fish_color_host 616161
fish_color_host_remote e3c401
fish_color_status f62b5a

# Prompt palette (functions/fish_prompt.fish)
fish_color_prompt_bar 242424
fish_color_prompt_icon 13c299
fish_color_prompt_mute 616161
fish_color_prompt_info 13c299
fish_color_prompt_duration e3c401
fish_color_prompt_char f2affd
fish_color_prompt_git_branch 47b413
fish_color_prompt_git_changes e3c401
fish_color_prompt_git_untracked 24acd4
