{
    "include": ["~/.config/waybar/machine.json"],
    "layer": "top",
    "position": "top",
    // Let the left/right groups use the empty centre (otherwise each is capped
    // at half the bar width)
    "fixed-center": false,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "cpu",
        "temperature#cpu",
        "temperature#gpu"
    ],
    "modules-center": [
	],
    "modules-right": [
        "pulseaudio",
        "custom/sway_audio_idle_inhibit",
        "network",
        "memory",
        "battery",
        "clock",
        "tray"
    ],

    // --- MODULE CONFIGURATION ---

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "clock": {
        "format": "{:%H:%M:%S %Y-%m-%d}",
        "interval": 1,
        "max-length": 35,
        // "" is local time; other zones become {tz_list} rows in the tooltip
        "timezones": ["", "Etc/UTC"],
        // Month calendar, then local time and UTC. {0:...} is the local time:
        // explicit indexes, since a bare {:...} would take the next argument
        "tooltip-format": "{calendar}\n\n<b>{0:%Z}</b>  {0:%H:%M:%S  %a %Y-%m-%d}\n{tz_list}",
        "timezone-tooltip-format": "<b>{0:%Z}</b>  {0:%H:%M:%S  %a %Y-%m-%d}",
        "calendar": {
            "mode": "month",
            // Months per scroll step. Setting it explicitly also makes the
            // calendar return to this month when the pointer leaves the clock
            "on-scroll": 1,
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<span color='#bbccdd'>{}</span>",
                "today": "<span color='#2b303b' bgcolor='#bbccdd'><b>{}</b></span>"
            }
        },
        // Left-click: Thunderbird's calendar (focus it if open, then switch to
        // the calendar tab). Launched through sway: waybar kills the processes
        // it started whenever it reloads
        "on-click": "swaymsg -q '[app_id=\"(?i)thunderbird\"] focus'; swaymsg -q exec 'thunderbird -calendar'",
        // Scroll pages through months; right-click jumps back to this month
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-right": "shift_reset"
        }
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },

    "memory": {
        "format": "{}% "
    },

    "temperature#cpu": {
        // First existing path wins: AMD k10temp, then Intel coretemp
        "hwmon-path-abs": [
            "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
            "/sys/devices/platform/coretemp.0/hwmon"
        ],
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon} ",
        "format-critical": "{temperatureC}°C {icon} ",
        "format-icons": ["", "", ""]
    },

    "temperature#gpu": {
        "hwmon-path-abs": "/sys/class/drm/card1/device/hwmon",
        "input-filename": "temp1_input",
        // No fallback zone: without the AMD GPU path the module disables itself
        // instead of reading thermal_zone0
        "thermal-zone": 999,
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}  ",
        "format-critical": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "interval": 2,
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },


    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "network": {
        // IP + Wi-Fi/ethernet icon; details in the tooltip, click for ifname/cidr
        "format-wifi": "{ipaddr} ",
        "format-ethernet": "{ipaddr} 󰈀",
        "format-linked": "No IP",
        "format-disconnected": "⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 30
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰝟 {icon} {format_source}",
        "format-muted": "󰝟 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    },

    "custom/sway_audio_idle_inhibit": {
        "format": "{icon}",
        "exec": "sway-audio-idle-inhibit --dry-print-both-waybar",
        "exec-if": "which sway-audio-idle-inhibit",
        "return-type": "json",
        "format-icons": {
            "output": " ",
            "input": " ",
            "output-input": "   ",
            "none": ""
        }
    }
}
